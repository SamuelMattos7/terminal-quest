{
  "name": "terminal-quest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"pnpm --filter @terminal-quest/server dev\" \"pnpm --filter @terminal-quest/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check apps packages *.json *.js *.ts",
    "test": "vitest run",
    "verify": "pnpm build && pnpm lint && pnpm test",
    "images:build": "echo \"tq-base image build not yet implemented (T1.1)\" && exit 1",
    "db:migrate": "echo \"db:migrate not yet implemented (T0.3)\" && exit 1",
    "levels:lint": "echo \"levels:lint not yet implemented (T2.1)\" && exit 1",
    "levels:test": "echo \"levels:test not yet implemented (T2.6)\" && exit 1",
    "e2e": "echo \"e2e not yet implemented (T5.2)\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.3"
  }
}

{
  "name": "terminal-quest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"pnpm --filter @terminal-quest/server dev\" \"pnpm --filter @terminal-quest/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check apps packages tools *.json *.js *.ts",
    "test": "vitest run",
    "test:docker": "pnpm --filter @terminal-quest/server test:docker && pnpm --filter @terminal-quest/level-runner test:docker",
    "verify": "pnpm build && pnpm lint && pnpm test",
    "images:build": "docker build -t tq-base -f packages/sandbox-images/base/Dockerfile packages/sandbox-images/base",
    "db:migrate": "pnpm --filter @terminal-quest/server db:migrate",
    "levels:lint": "pnpm --filter @terminal-quest/level-runner lint",
    "levels:test": "pnpm --filter @terminal-quest/level-runner levels:test",
    "e2e": "echo \"e2e not yet implemented (T5.2)\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.3"
  }
}

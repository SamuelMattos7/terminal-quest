#!/usr/bin/python3
import os
import sys

from tq_systemd_units import JOURNAL_DIR, UNIT_NAME, journal_path


def main(args):
    if args in (["-h"], ["--help"]):
        print("Usage: journalctl -u <unit>")
        return 0
    if len(args) != 2 or args[0] != "-u" or not UNIT_NAME.fullmatch(args[1]):
        print("Usage: journalctl -u <unit>", file=sys.stderr)
        return 2
    if not JOURNAL_DIR.is_dir():
        print("journalctl: simulation unavailable", file=sys.stderr)
        return 1
    path = journal_path(args[1])
    if not path.exists():
        print("-- No entries --")
        return 0
    os.execv("/usr/bin/cat", ["cat", str(path)])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
